# Copy this file to create a new environment file (.env.local, .env.dev, etc).
# Every variable here is required by shared/src/env/schema.ts.
# CMS_BASE_URL / PUBLIC_BASE_URL / MEMBER_BASE_URL are DOMAIN ROOTS only.
# Do not append paths like /login or a creator slug here — those are composed
# at the Route Registry layer (Milestone 2) from CREATOR_SLUG + these domains.

# local | development | staging | production
APP_ENV=local

# ---- Base URLs (domain root only, no trailing path) ----
CMS_BASE_URL=
PUBLIC_BASE_URL=
MEMBER_BASE_URL=

# Reserved for when a dedicated backend API host exists. Leave unset until then.
API_BASE_URL=

# Creator slug used to build Public MyLink and Member Area paths for this environment
CREATOR_SLUG=

# ---- Timeouts (milliseconds) ----
DEFAULT_ACTION_TIMEOUT_MS=15000
DEFAULT_NAVIGATION_TIMEOUT_MS=30000

# ---- Test credentials ----
# Never commit real values. Override locally or inject via CI secrets.
CMS_USERNAME=CHANGE_ME
CMS_PASSWORD=CHANGE_ME
MEMBER_EMAIL=CHANGE_ME
