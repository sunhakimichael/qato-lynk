{
  "name": "@qato/automation-playwright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:cms": "playwright test --grep @cms",
    "test:mylink": "playwright test --grep @mylink",
    "test:member": "playwright test --grep @member",
    "test:smoke": "playwright test --grep @smoke",
