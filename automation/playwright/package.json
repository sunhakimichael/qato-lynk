    "test:payment": "playwright test --grep @payment",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qato/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
